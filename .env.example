LLM_PROVIDER=openai  
LLM_MODEL=gpt-4o
ANTHROPIC_API_KEY=

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

GOOGLE_API_KEY=

SECONDARY_LLM_PROVIDER=gemini
SECONDARY_LLM_MODEL=gemini-2.0-flash

